# Application
APP_NAME=AI Trading Bot
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO
LOG_DIR=logs

# Trading
TRADING_MODE=paper
DEFAULT_SYMBOL=AAPL
DEFAULT_TIMEFRAME=1h
BASE_CURRENCY=USD

# Risk Management
MAX_POSITION_SIZE_PCT=0.05
MAX_DAILY_LOSS_PCT=0.02
MAX_OPEN_POSITIONS=10

# ---------------------------------------------------------------------------
# Milestone 13.2 — hard LIVE enablement (default DENY; BROKER_SANDBOX only)
# ---------------------------------------------------------------------------
# Passing every gate authorizes supervised sandbox wiring via:
#   python main.py run-once --live ...
#   python main.py run-session --cycles N --live ...
# It does NOT authorize a real-money trial (M14). LIVE_PRODUCTION is hard-denied.
# run-paper-operator and run-backtest cannot use LIVE.
#
# LIVE_TRADING_ENABLED=false
# LIVE_CONFIRM_TOKEN=
#   # Must exactly equal: I_UNDERSTAND_LIVE_IS_GATED_NOT_A_TRIAL
# BROKER_ENDPOINT_CLASS=local_paper
#   # For gated sandbox: broker_sandbox
#   # live_production is always rejected in M13.2
# LIVE_MAX_ORDER_NOTIONAL=
# LIVE_MAX_ORDERS_PER_DAY=
# LIVE_MAX_GROSS_NOTIONAL=
#   # optional in M13.2; revisit before M14
LIVE_TRADING_ENABLED=false
LIVE_CONFIRM_TOKEN=
BROKER_ENDPOINT_CLASS=local_paper
# LIVE_MAX_ORDER_NOTIONAL=1000
# LIVE_MAX_ORDERS_PER_DAY=5
#
# Milestone 13.3 — required for execution=live (atomic JSON ledger; abort-only reconcile):
# LIVE_ORDER_LEDGER_PATH=./state/live_order_ledger.json
# LIVE_ENTRY_PRICE_EPSILON=0.0001
#
# Milestone 13.4 — required for execution=shadow (append-only JSONL; no-submit):
# SHADOW_AUDIT_PATH=./state/shadow_audit.jsonl
#   python main.py run-once --shadow ...
#   python main.py run-session --cycles N --shadow ...
# Shadow never place_order. LIVE_PRODUCTION remains denied. Not a real-money trial.

# Broker
# Local simulated paper broker (default factory path):
BROKER_NAME=paper
BROKER_API_KEY=
BROKER_API_SECRET=
BROKER_BASE_URL=https://paper-api.example.com
#
# Milestone 13.1/13.2 — Alpaca paper/sandbox adapter (Adapter #1):
#   BROKER_NAME=alpaca_paper
#   BROKER_BASE_URL=https://paper-api.alpaca.markets
#   BROKER_API_KEY=<alpaca paper key id>
#   BROKER_API_SECRET=<alpaca paper secret>
#   BROKER_ENDPOINT_CLASS=broker_sandbox
# Live host api.alpaca.markets is rejected by the Alpaca adapter.
# Factory wires Alpaca only under execution=live + all M13.2 gates.
# Never commit real keys. Never log secrets.

# Market Data
# Supported providers: mock, yahoo (alias: yfinance)
# Prefer mock for CI/local. yahoo hits the network — supervised paper only (see README M11).
# Prefer TRADING_MODE=paper. LIVE requires all M13.2 gates + --live CLI.
MARKET_DATA_PROVIDER=mock
MARKET_DATA_API_KEY=
# M11.2 freshness (wall-clock age of last closed bar; not market-hours)
MARKET_DATA_FRESHNESS_ENABLED=true
# MARKET_DATA_MAX_AGE_SECONDS=  # optional absolute override; empty → derive from timeframe
MARKET_DATA_FRESHNESS_BAR_PERIODS=2
MARKET_DATA_FRESHNESS_SLACK_SECONDS=120
MARKET_DATA_FUTURE_SKEW_SECONDS=60
# M11.3 market hours (XNYS; allow = supervised M11 default; reject for unattended/M12)
MARKET_HOURS_ENABLED=true
MARKET_HOURS_POLICY=allow
MARKET_HOURS_CALENDAR=xnys
MARKET_HOURS_TIMEZONE=America/New_York

# ---------------------------------------------------------------------------
# Milestone 12 — unattended paper operator (run-paper-operator)
# ---------------------------------------------------------------------------
# Operator bounds, --state-path, and --kill-file are CLI-REQUIRED (Decision G1).
# Do NOT expect .env alone to start an unattended loop.
#
# For unattended operator runs you MUST use:
#   TRADING_MODE=paper
#   MARKET_HOURS_ENABLED=true
#   MARKET_HOURS_POLICY=reject
# Prefer MARKET_DATA_PROVIDER=mock for CI/local. yahoo is manual overnight only.
# Optional emergency env kill (in addition to --kill-file): PAPER_OPERATOR_KILL=1
# Never set TRADING_MODE=live.
# See README "Unattended paper operator" and MILESTONE_12_SUMMARY.md.

# AI Engine
AI_PROVIDER=mock
AI_MODEL=gpt-4
AI_API_KEY=
AI_TEMPERATURE=0.2

# News Engine
NEWS_PROVIDER=mock
NEWS_API_KEY=

# Alerts
ALERTS_ENABLED=true
ALERT_EMAIL=
ALERT_WEBHOOK_URL=

# Backtesting
BACKTEST_INITIAL_CAPITAL=100000
BACKTEST_COMMISSION_PCT=0.001
